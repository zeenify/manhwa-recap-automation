# ---- heavy regenerable media (never public, never tracked) ----
*.jpg
*.jpeg
*.png
*.webp
*.mp3
*.mp4
*.m4a
*.webm

# ---- secrets ----
tmp/

# ---- per-run artifacts (the sample in examples/ shows the formats) ----
scripts/
assets/
audio/
videos/
__pycache__/

# ---- reader/writer run artifacts (drafts, handoffs, view manifests) ----
toonverse/**/beats_draft_*.json
toonverse/**/beats_full_*.json
toonverse/**/handoff_*.json
toonverse/**/views/
toonverse/**/window_*.png

# ---- secrets & scratch (never public) ----
channel/analytics/credentials.json
tmp/

# ---- author-private material (kept local, never pushed) ----
agents/writer-agent-fdb.md
research/fdb_style_notes.md
channel/thumbnail-research/

# ---- except bundled changelog evidence (small, versioned on purpose) ----
!changelog/**/*.jpg
!changelog/**/*.jpeg
!changelog/**/*.png

# ---- run artifacts that predate these ignore rules (keep local) ----
toonverse/**/*.bak
toonverse/**/continuation_checkpoint_*.json
toonverse/**/verification_*.json
